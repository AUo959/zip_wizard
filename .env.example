# Database Configuration
# Postgres/Neon database connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# Server Configuration  
NODE_ENV=development
PORT=3000

# API authentication. Configure a single token or a JSON credential map.
# API_AUTH_TOKEN=
# API_AUTH_USER_ID=zip-operator
# API_AUTH_CREDENTIALS=
# API_AUTH_ADMIN_USERS=
# DEV_AUTH_BYPASS_USER_ID=local-operator
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# API Keys (optional - for future AI/ML features)
# ANTHROPIC_API_KEY=your-api-key-here

# Application Settings
# Maximum file upload size in MB (default: 50)
MAX_UPLOAD_SIZE=50

# Archive processing timeout in ms (default: 300000 = 5 minutes)
ARCHIVE_PROCESSING_TIMEOUT=300000
